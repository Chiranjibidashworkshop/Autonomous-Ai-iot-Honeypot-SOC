[Unit]
Description=Autonomous AI-Driven IoT Honeypot
After=network.target

[Service]
Type=simple
User=honeypot
WorkingDirectory=/opt/autonomous_ai_iot_honeypot_soc
EnvironmentFile=/opt/autonomous_ai_iot_honeypot_soc/.env
ExecStart=/opt/autonomous_ai_iot_honeypot_soc/.venv/bin/python -m src.iot_honeypot.main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
